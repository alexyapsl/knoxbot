# --- Environment ---
# "stage" or "production" (selects the default base URL)
KNOX_ENV=stage
# Override only if Samsung gives you a different base URL
# KNOX_BASE_URL=https://openapi.stage.samsung.net

# --- Knox Dev Center credentials (required) ---
# Access token issued when the Bot Interface request is approved
KNOX_ACCESS_TOKEN=
# System ID shown with the bot interface (e.g. C60LD0001)
KNOX_SYSTEM_ID=
# Bot account email (appears as botUserEmail on inbound pushes)
KNOX_BOT_EMAIL=

# --- Optional; auto-fetched at startup if left blank ---
# x-device-id from GET /messenger/contact/api/v2.0/device/o1/reg
KNOX_DEVICE_ID=
# Message encryption key (hex) from GET /messenger/msgctx/api/v2.0/key/getkeys
KNOX_ENCRYPTION_KEY=

# --- AES tuning (docs only say "AES256 + Base64"; verify on stage) ---
# CBC or ECB
KNOX_AES_MODE=CBC
# 16-byte IV as hex; blank = zero IV (CBC only)
KNOX_AES_IV=

# --- HTTP server (Receiving API) ---
KNOX_HOST=0.0.0.0
KNOX_PORT=8080

# Set to false to receive-and-log without replying
KNOX_ECHO_ENABLED=true

# Knox Portal REST APIs (Employee / Calendar PIMS) - later phases
KNOX_REST_SYSTEM_ID=
KNOX_REST_ACCESS_TOKEN=
